{
    "version": 2,
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/landing.html",
            "dest": "/index.html"
        },
        {
            "src": "/products.html",
            "dest": "/products.html"
        },
        {
            "src": "/login/?$",
            "dest": "/login.html"
        },
        {
            "src": "/login/(.*)",
            "dest": "/login.html"
        },
        {
            "src": "/admin/?$",
            "dest": "/admin.html"
        },
        {
            "src": "/admin/(.*)",
            "dest": "/admin.html"
        }
    ]
}