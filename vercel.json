{
    "version": 2,
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/admin/index.html"
        },
        {
            "source": "/admin/",
            "destination": "/admin/index.html"
        },
        {
            "source": "/admin/(.*)",
            "destination": "/admin/$1"
        },
        {
            "source": "/",
            "destination": "/public/index.html"
        },
        {
            "source": "/landing.html",
            "destination": "/landing.html"
        },
        {
            "source": "/products.html",
            "destination": "/public/products.html"
        },
        {
            "source": "/css/:path*",
            "destination": "/public/css/:path*"
        },
        {
            "source": "/js/:path*",
            "destination": "/public/js/:path*"
        },
        {
            "source": "(.*)",
            "destination": "/public/$1"
        }
    ]
}