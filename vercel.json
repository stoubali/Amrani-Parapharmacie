{
    "version": 2,
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/landing.html",
            "dest": "/landing.html"
        },
        {
            "src": "/products.html",
            "dest": "/products.html"
        },
        {
            "src": "/admin",
            "dest": "/admin/index.html"
        },
        {
            "src": "/admin/",
            "dest": "/admin/index.html"
        },
        {
            "src": "/admin/(.*)",
            "dest": "/admin/$1"
        }
    ]
}